{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitAny": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "jest.config.ts",
    "vitest.config.ts",
    "src/types/test.types.ts",
    "src/db/prisma/seed.ts" // 🔴 CI 빌드에서 제외 (런타임에 안 쓰면 안전)
  ]
}
